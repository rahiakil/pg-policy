-- basic regression input for pg_agent_policy
DROP EXTENSION IF EXISTS pg_agent_policy CASCADE;
NOTICE:  extension "pg_agent_policy" does not exist, skipping
CREATE EXTENSION pg_agent_policy;
SELECT agent_policy.set_setting('enforcement_mode', 'enforce');
 set_setting 
-------------
 
(1 row)

SELECT agent_policy.upsert_policy('block_ddl', $apl$
forbid
  principal agent "bot"
  action tool "execute_sql"
  when { context.statement_type in ["DROP", "ALTER"] }
  reason "no ddl"
$apl$);
 upsert_policy 
---------------
             1
(1 row)

SELECT (agent_policy.evaluate(
  'agent','bot','tool','execute_sql','*','*',
  '{"statement_type":"DROP"}'::jsonb
)->>'decision') AS drop_decision;
 drop_decision 
---------------
 deny
(1 row)

-- Default deny: SELECT matches no permit/forbid yet, so deny.
SELECT (agent_policy.evaluate(
  'agent','bot','tool','execute_sql','*','*',
  '{"statement_type":"SELECT"}'::jsonb
)->>'decision') AS select_decision_before_permit;
 select_decision_before_permit 
-------------------------------
 deny
(1 row)

SELECT agent_policy.upsert_policy('guide_sql', $apl$
guide
  principal agent "bot"
  action tool "execute_sql"
  advice "prefer explain"
  max_rows 100
$apl$);
 upsert_policy 
---------------
             2
(1 row)

SELECT (agent_policy.evaluate(
  'agent','bot','tool','execute_sql','*','*',
  '{"statement_type":"SELECT"}'::jsonb
)->>'decision') AS select_decision;
 select_decision 
-----------------
 allow
(1 row)

SELECT agent_policy.evaluate(
  'agent','bot','tool','execute_sql','*','*',
  '{"statement_type":"SELECT"}'::jsonb
)->'obligations' AS obligations;
                                     obligations                                     
-------------------------------------------------------------------------------------
 [{"type": "advice", "value": "prefer explain"}, {"type": "max_rows", "value": 100}]
(1 row)

